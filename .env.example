# Copy to .env and fill in. Every setting in src/cs2bot/config.py can be set here:
# prefix CS2BOT_, nested sections joined with double underscores.

CS2BOT_ENVIRONMENT=prod
CS2BOT_TIMEZONE=Europe/Warsaw
CS2BOT_LOG_LEVEL=INFO
CS2BOT_LOG_JSON=true

# --- Database ---------------------------------------------------------------
# PostgreSQL runs in Docker Desktop (docker-compose.yml) and is published on localhost only.
CS2BOT_DATABASE__URL=postgresql+psycopg://cs2bot:change-me@127.0.0.1:5432/cs2bot

# --- Data sources -----------------------------------------------------------
CS2BOT_PANDASCORE__API_TOKEN=
# Optional residential proxy for HLTV (http://user:pass@host:port)
CS2BOT_HLTV__PROXY_URL=
# Visible HLTV browser: fewer Cloudflare challenges on the desktop (a clearance cookie earned in the
# `cs2bot ingest hltv-browser` window is bound to the visible browser's user agent).
# CS2BOT_HLTV__HEADLESS=false

# --- Claude (news/context layer) --------------------------------------------
ANTHROPIC_API_KEY=
CS2BOT_LLM__CONTEXT_MODEL=claude-opus-5-5
CS2BOT_LLM__TRIAGE_MODEL=claude-haiku-5-5

# --- Betclic -----------------------------------------------------------------
# You log in by hand once in the bot's own browser window (incl. 2FA); the dedicated browser
# profile then keeps the session. Storing credentials is optional: "none" (default),
# "env" (the two lines below) or "keyring" (Windows Credential Manager, service cs2bot-betclic).
CS2BOT_BETCLIC__CREDENTIALS_SOURCE=none
CS2BOT_BETCLIC__USERNAME=
CS2BOT_BETCLIC__PASSWORD=
CS2BOT_BETCLIC__TAX_FREE_PROMO=false
CS2BOT_BETCLIC__PROXY_URL=

# --- Money & risk -------------------------------------------------------------
CS2BOT_BANKROLL__STARTING_BANKROLL=1000.00
# Only used with STAKING_MODE=kelly (see the decision rule below)
CS2BOT_BANKROLL__KELLY_FRACTION=0.25
# Caps every stake; each confidence tier's fraction must be <= this
CS2BOT_BANKROLL__MAX_STAKE_FRACTION=0.02
CS2BOT_BANKROLL__MAX_MATCH_EXPOSURE_FRACTION=0.04
CS2BOT_BANKROLL__DAILY_LOSS_LIMIT_FRACTION=0.05
CS2BOT_BANKROLL__WEEKLY_LOSS_LIMIT_FRACTION=0.10
CS2BOT_BANKROLL__MAX_BETS_PER_DAY=10

# --- Decision rule (PLAN.md section 6) ----------------------------------------
CS2BOT_DECISION__MIN_PROBABILITY=0.75
# -1.0 = odds are not a criterion (bet on confidence only); 0.0 = break-even guard
CS2BOT_DECISION__MIN_EV=-1.0
# Stake by confidence tier (ignores odds) or fractional Kelly
CS2BOT_BANKROLL__STAKING_MODE=confidence_tiers
# [minimum probability, fraction of the bankroll]: 75-85 % sure = 1 %, 85-92 % = 1.5 %, 92 %+ = 2 %
# (sorted, fractions <= MAX_STAKE_FRACTION; per-match / daily / weekly caps still apply)
# CS2BOT_BANKROLL__CONFIDENCE_TIERS=[[0.75,0.01],[0.85,0.015],[0.92,0.02]]
# A WIN must pay back more than the stake: after the 12 % stake tax that needs odds >= 1.137
# (e.g. 1.10 pays 0.968 per 1 PLN staked even when it wins). false = odds fully ignored.
CS2BOT_DECISION__REQUIRE_PROFITABLE_WIN=true
# Shrink probabilities above 75 % where the backtest showed over-confidence (no backtest yet: keep
# half of the excess over 75 %); applied before the 75 % check and the stake tier.
CS2BOT_DECISION__USE_CONFIDENCE_GUARD=true
# Bet a market type only once the backtest marks its calibration as trusted (needs weeks of prices)
# CS2BOT_DECISION__REQUIRE_TRUSTED_CALIBRATION=false
# Weekly unattended backtest that refreshes the guard (0 = off); see docs/OPERATIONS.md
# CS2BOT_MODELS__GUARD_REFRESH_DAYS=7
CS2BOT_DECISION__MAX_SIGMA=0.05
CS2BOT_DECISION__MIN_DATA_COMPLETENESS=0.95

# --- Executor -------------------------------------------------------------------
# true = simulate placement only. Set to false to place REAL bets.
CS2BOT_EXECUTOR__DRY_RUN=true
# Visible browser. On the Linux VPS it runs on the Xvfb virtual display (DISPLAY=:99, set by the
# container); without any display the browser falls back to headless (HEADLESS_WITHOUT_DISPLAY).
CS2BOT_EXECUTOR__HEADLESS=false
# CS2BOT_EXECUTOR__HEADLESS_WITHOUT_DISPLAY=true

# --- Autonomy (unattended VPS operation, PLAN.md 0b) ------------------------------
# Off by default (Windows PC). On the VPS: ENABLED=true and AUTO_LOGIN=true with
# CS2BOT_BETCLIC__CREDENTIALS_SOURCE=env and the username/password above. The bot fills AND submits
# the Betclic login form; if Betclic asks for an SMS / 2FA code it stays paused and alerts you.
CS2BOT_AUTONOMY__ENABLED=false
CS2BOT_AUTONOMY__AUTO_LOGIN=false
CS2BOT_AUTONOMY__AUTO_RESUME=true
CS2BOT_AUTONOMY__CHECK_INTERVAL_MIN=5
# Circuit breaker: the same pause reason may lift itself at most LIMIT times per WINDOW_H hours.
CS2BOT_AUTONOMY__CIRCUIT_BREAKER_LIMIT=3
CS2BOT_AUTONOMY__CIRCUIT_BREAKER_WINDOW_H=24
CS2BOT_AUTONOMY__LOGIN_RETRY_INTERVAL_MIN=15
# Submitted logins in a row that neither log in nor reach the SMS step before the auto-login stops
# until you /resume (a recognised wrong password / locked account stops at once; a restart does not retry)
CS2BOT_AUTONOMY__MAX_LOGIN_FAILURES=3
CS2BOT_AUTONOMY__TWOFA_RETRY_INTERVAL_MIN=240

# --- Telegram (notifications + /status /pause /resume /stop /go) -------------------
# Token from @BotFather, your numeric chat id from @userinfobot. Commands are accepted only from this
# chat id (an @channel name receives notifications but cannot send commands).
CS2BOT_TELEGRAM__ENABLED=false
CS2BOT_TELEGRAM__BOT_TOKEN=
CS2BOT_TELEGRAM__CHAT_ID=
# Daily P&L report, Europe/Warsaw time (HH:MM)
CS2BOT_TELEGRAM__DAILY_REPORT_TIME=21:00
# CS2BOT_TELEGRAM__NOTIFY_BETS=true
# CS2BOT_TELEGRAM__NOTIFY_DRY_RUN_BETS=true
# CS2BOT_TELEGRAM__NOTIFY_SETTLEMENTS=true
# CS2BOT_TELEGRAM__NOTIFY_CONTROL=true
# CS2BOT_TELEGRAM__NOTIFY_ERRORS=true
# CS2BOT_TELEGRAM__NOTIFY_LIFECYCLE=true
# CS2BOT_TELEGRAM__DAILY_REPORT=true
# CS2BOT_TELEGRAM__COMMANDS_ENABLED=true

# --- Dashboard / API --------------------------------------------------------------
# Local only: http://127.0.0.1:8000 . A password is only required if you change the host.
# On the VPS docker-compose.cloud.yml sets HOST=0.0.0.0 (reachable only through Caddy) and
# FORWARDED_ALLOW_IPS to Caddy's fixed address (real client IP for the login rate limit, Secure cookie).
CS2BOT_API__HOST=127.0.0.1
CS2BOT_API__PORT=8000
CS2BOT_API__USERNAME=admin
CS2BOT_API__PASSWORD=
CS2BOT_API__SESSION_SECRET=

# --- PostgreSQL container (docker-compose.yml reads these from .env) ------------
# POSTGRES_USER=cs2bot
# POSTGRES_PASSWORD=change-me   # must equal the password in CS2BOT_DATABASE__URL
# POSTGRES_DB=cs2bot
# POSTGRES_PORT=5432            # also change the port in CS2BOT_DATABASE__URL
# POSTGRES_SHARED_BUFFERS=1GB   # 512MB on 8 GB RAM PCs
# POSTGRES_EFFECTIVE_CACHE_SIZE=3GB

# --- VPS only (docker-compose.cloud.yml; deploy/linux/init-env.sh writes these) -----
# COMPOSE_FILE=docker-compose.cloud.yml   # plain `docker compose ...` then uses the cloud file
# APP_UID=10001                           # owner of data/ and logs/ on the host (never 0)
# APP_GID=10001
# CS2BOT_PUBLIC_HOST=bot.example.pl       # dashboard domain (or the VPS IPv4)
# CS2BOT_TLS_MODE=auto                    # auto = Let's Encrypt for a domain, internal = for an IP
# CADDY_IPV4=172.30.250.10                # Caddy's fixed address on the frontend network
# FRONTEND_SUBNET=172.30.250.0/24         # change both only if the subnet collides on the VPS
# VNC_HOST_PORT=5900                      # vnc.sh, bound to the VPS's 127.0.0.1 only
# BACKUP_KEEP_DAYS=14                     # backup.sh retention
# BACKUP_INCLUDE_DATA=false               # also archive data/models + data/browser (journal, session)
# RCLONE_REMOTE=                          # off-site copy, e.g. b2:cs2bot-backups
# RCLONE_KEEP_DAYS=30
